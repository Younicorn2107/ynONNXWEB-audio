{
  "name": "@youni/onnxweb-audio",
  "version": "1.0.0",
  "description": "Audio in the browser over @youni/onnxweb-core: speech-to-text first, then voice activity, speakers, alignment, language, emotion and sound events.",
  "license": "Apache-2.0",
  "author": "Youni",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json",
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "lint": "eslint src tests"
  },
  "peerDependencies": {
    "@youni/onnxweb-core": "^1.0.0",
    "onnxruntime-web": ">=1.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.72",
    "onnxruntime-web": "^1.29.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@youni/onnxweb-core": "^1.0.0",
    "eslint": "^9.36.0",
    "@eslint/js": "^9.36.0",
    "typescript-eslint": "^8.44.0"
  },
  "keywords": [
    "audio",
    "speech-to-text",
    "whisper",
    "onnx",
    "webgpu",
    "webnn",
    "wasm",
    "browser"
  ]
}
